OT_ENVIRONMENT=dev
OT_DEFAULT_PROVIDER=microsoft
OT_DEFAULT_MODEL=MAI-Transcribe-2

OT_MICROSOFT__ENDPOINT=
OT_MICROSOFT__API_KEY=
OT_MICROSOFT__API_VERSION=2025-10-15

OT_ELEVENLABS__API_KEY=
OT_ELEVENLABS__BASE_URL=https://api.elevenlabs.io
OT_ELEVENLABS__ZERO_RETENTION=true

OT_GROQ__API_KEY=
OT_GROQ__BASE_URL=https://api.groq.com/openai/v1

OT_SECURITY__AUTH_MODE=bearer
OT_SECURITY__BEARER_TOKEN=replace-with-a-random-secret
OT_SECURITY__REQUIRE_HTTPS_SOURCES=true
OT_SECURITY__ALLOW_PRIVATE_URLS=false
OT_SECURITY__MAX_REDIRECTS=3

OT_RESULT_STORE__BACKEND=disabled
OT_RESULT_STORE__CURSOR_SECRET=
OT_RESULT_STORE__TTL_SECONDS=86400
OT_RESULT_STORE__S3_BUCKET=
OT_RESULT_STORE__S3_ENDPOINT_URL=
OT_RESULT_STORE__S3_REGION=fr-par
OT_RESULT_STORE__S3_PREFIX=transcripts

OT_REQUEST_TIMEOUT_SECONDS=900
OT_PROVIDER_TIMEOUT_SECONDS=600
OT_SOURCE_DOWNLOAD_TIMEOUT_SECONDS=120
OT_MAX_AUDIO_SIZE_MB=500
OT_MAX_AUDIO_DURATION_SECONDS=21600
OT_MAX_REQUEST_COST_USD=
OT_MAX_INLINE_TEXT_CHARS=100000
OT_MAX_INLINE_SEGMENTS=1000
OT_MAX_INLINE_RESPONSE_BYTES=400000
